function automatic void rivet_phy_dec10(
  input logic [9:0] code, input logic rd_neg,
  output logic [7:0] d, output logic k, output logic rd_neg_n,
  output logic code_err, output logic disp_err);
  d = '0; k = 1'b0; rd_neg_n = rd_neg;
  code_err = 1'b0; disp_err = 1'b0;
  unique case (code)
    10'b0001010101: begin d = 8'h57; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
    10'b0001010110: begin d = 8'hD7; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
    10'b0001010111: begin d = 8'hF7; k = 1'b1; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b0; disp_err = 1'b0; end end
    10'b0001011001: begin d = 8'h37; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
    10'b0001011010: begin d = 8'hB7; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
    10'b0001011011: begin d = 8'h17; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b0; disp_err = 1'b0; end end
    10'b0001011100: begin d = 8'h77; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
    10'b0001011101: begin d = 8'h97; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b0; disp_err = 1'b0; end end
    10'b0001011110: begin d = 8'hF7; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b0; disp_err = 1'b0; end end
    10'b0001100101: begin d = 8'h48; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
    10'b0001100110: begin d = 8'hC8; k = 1'b0; if (rd_neg) begin rd_neg_n = 1'b1; disp_err = 1'b1; end else begin rd_neg_n = 1'b1; disp_err = 1'b0; end end
