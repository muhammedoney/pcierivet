set script_dir [file normalize [file dirname [info script]]]
set repo_root  [file normalize [file join $script_dir .. ..]]
set build_dir  [file join $script_dir build]
set ip_dir     [file join $build_dir ip]
set part       1SG280HU2F50E2VG

proc rivet_patch_cdc_2phase {src build regs_svh} {
  set dst_dir [file join $build src]
  set inc_dir [file join $dst_dir common_cells]
  file mkdir $inc_dir
  set dst [file join $dst_dir cc_cdc_2phase.sv]
  set fh [open $src r]
  set text [read $fh]
  close $fh
  if {![string match "*data_t'('0)*" $text]} {
    error "cc_cdc_2phase.sv no longer contains data_t'('0); update the Quartus patch"
  }
  if {![string match {*`include "common_cells/registers.svh"*} $text]} {
    error "cc_cdc_2phase.sv no longer includes common_cells/registers.svh; update the Quartus patch"
  }
  set text [string map [list {data_t'('0)} {'0}] $text]
  set out [open $dst w]
  puts -nonewline $out $text
  close $out
  file copy -force $regs_svh [file join $inc_dir registers.svh]
  return [file normalize $dst]
}

proc rivet_quartus_bindir {} {
  set exe [info nameofexecutable]
  if {$exe eq ""} {
    error "quartus_sh did not identify its executable"
  }
  return [file dirname $exe]
}

proc rivet_tool {bindir name} {
  set roots [list \
    $bindir \
    [file normalize [file join $bindir .. sopc_builder bin]] \
    [file normalize [file join $bindir .. .. qsys bin]]]
  foreach root $roots {
    foreach ext {".exe" ""} {
      set path [file join $root $name$ext]
      if {[file exists $path]} {
        return $path
      }
    }
  }
  error "missing $name under $bindir, sopc_builder\\bin, or qsys\\bin"
}

proc rivet_find_named {dir tail} {
  set hits {}
  foreach f [glob -nocomplain -directory $dir *] {
    if {[file isdirectory $f]} {
      set hits [concat $hits [rivet_find_named $f $tail]]
    } elseif {[file tail $f] eq $tail} {
      lappend hits $f
    }
  }
  return $hits
}

proc rivet_emit_fixed_link {path} {
  set fh [open $path w]
  puts $fh {// Generated by fpga/s10gx/create_project.tcl.
// Stitches the ATX PLL, L/H-tile Native PHY, and reset controller.
// The system qsys-generate hangs in quartus_sh --ipc_sh on this host.
module rivet_s10gx_link (
  input  wire         refclk,
  input  wire         clk50,
  input  wire         reset_n,
  output wire [3:0]   tx_serial_data,
  input  wire [3:0]   rx_serial_data,
  output wire         pipe_clk,
  output wire         phy_ready,
  input  wire [319:0] tx_parallel_data,
  output wire [319:0] rx_parallel_data,
  output wire [3:0]   rx_elecidle
);

  wire        pll_locked;
  wire        pll_pcie_clk;
  wire [5:0]  pll_bonding_clocks;
  wire [23:0] tx_bonding_clocks;
  wire [1:0]  pipe_sw;
  wire [1:0]  pipe_sw_done;
  wire [3:0]  tx_analogreset;
  wire [3:0]  tx_digitalreset;
  wire [3:0]  rx_analogreset;
  wire [3:0]  rx_digitalreset;
  wire [3:0]  tx_analogreset_stat;
  wire [3:0]  tx_digitalreset_stat;
  wire [3:0]  rx_analogreset_stat;
  wire [3:0]  rx_digitalreset_stat;
  wire [3:0]  tx_cal_busy;
  wire [3:0]  rx_cal_busy;
  wire [3:0]  tx_ready;
  wire [3:0]  rx_ready;
  wire [3:0]  rx_is_lockedtodata;
  wire [3:0]  tx_clkout;

  assign phy_ready = (&tx_ready) & (&rx_ready);
  assign pipe_clk = tx_clkout[0];
  assign tx_bonding_clocks = {4{pll_bonding_clocks}};

  rivet_s10gx_xcvr_pll_0 u_pll (
    .pll_refclk0       (refclk),
    .tx_serial_clk     (),
    .pll_locked        (pll_locked),
    .pll_pcie_clk      (pll_pcie_clk),
    .pll_cal_busy      (),
    .tx_bonding_clocks (pll_bonding_clocks),
    .pcie_sw           (pipe_sw),
    .pcie_sw_done      (pipe_sw_done)
  );

  rivet_s10gx_xcvr_rst_0 u_rst (
    .clock                (clk50),
    .reset                (~reset_n),
    .tx_analogreset       (tx_analogreset),
    .tx_digitalreset      (tx_digitalreset),
    .tx_ready             (tx_ready),
    .pll_locked           (pll_locked),
    .pll_select           (1'b0),
    .tx_cal_busy          (tx_cal_busy),
    .tx_analogreset_stat  (tx_analogreset_stat),
    .tx_digitalreset_stat (tx_digitalreset_stat),
    .rx_analogreset       (rx_analogreset),
    .rx_digitalreset      (rx_digitalreset),
    .rx_ready             (rx_ready),
    .rx_is_lockedtodata   (rx_is_lockedtodata),
    .rx_cal_busy          (rx_cal_busy),
    .rx_analogreset_stat  (rx_analogreset_stat),
    .rx_digitalreset_stat (rx_digitalreset_stat)
  );

  rivet_s10gx_xcvr_phy_0 u_phy (
    .pipe_sw_done          (pipe_sw_done),
    .pipe_sw               (pipe_sw),
    .tx_analogreset        (tx_analogreset),
    .rx_analogreset        (rx_analogreset),
    .tx_digitalreset       (tx_digitalreset),
    .rx_digitalreset       (rx_digitalreset),
    .tx_analogreset_stat   (tx_analogreset_stat),
    .rx_analogreset_stat   (rx_analogreset_stat),
    .tx_digitalreset_stat  (tx_digitalreset_stat),
    .rx_digitalreset_stat  (rx_digitalreset_stat),
    .tx_cal_busy           (tx_cal_busy),
    .rx_cal_busy           (rx_cal_busy),
    .tx_bonding_clocks     (tx_bonding_clocks),
    .rx_cdr_refclk0        (refclk),
    .tx_serial_data        (tx_serial_data),
    .rx_serial_data        (rx_serial_data),
    .rx_is_lockedtoref     (),
    .rx_is_lockedtodata    (rx_is_lockedtodata),
    .tx_coreclkin          ({4{pipe_clk}}),
    .rx_coreclkin          ({4{pipe_clk}}),
    .tx_clkout             (tx_clkout),
    .tx_clkout2            (),
    .rx_clkout             (),
    .tx_parallel_data      (tx_parallel_data),
    .rx_parallel_data      (rx_parallel_data),
    .pipe_hclk_in          (pll_pcie_clk),
    .pipe_hclk_out         (),
    .pipe_rx_eidleinfersel (12'b0),
    .pipe_rx_elecidle      (rx_elecidle)
  );
endmodule
}
  close $fh
}

proc rivet_add_filelist {repo listfile build regs_svh} {
  set fh [open $listfile r]
  while {[gets $fh line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "#*" $line]} {
      continue
    }
    if {[string match "-f *" $line]} {
      set sub [string trim [string range $line 3 end]]
      rivet_add_filelist $repo [file join $repo $sub] $build $regs_svh
      continue
    }
    set path [file normalize [file join $repo $line]]
    if {![file exists $path]} {
      close $fh
      error "missing source: $path"
    }
    if {[string match *cc_cdc_2phase.sv $path]} {
      set path [rivet_patch_cdc_2phase $path $build $regs_svh]
    }
    if {[string match *.sv $path]} {
      set_global_assignment -name SYSTEMVERILOG_FILE $path
    } else {
      set_global_assignment -name VERILOG_FILE $path
    }
  }
  close $fh
}

file mkdir $build_dir
# Each save_system otherwise keeps the previous IP and writes _1, _2, ...
# A clean directory makes the generated module names stable.
if {[file exists $ip_dir]} {
  file delete -force $ip_dir
}
file mkdir $ip_dir

set bindir [rivet_quartus_bindir]
set qsys [rivet_tool $bindir qsys-script]
set qgen [rivet_tool $bindir qsys-generate]
set gen_tcl [file join $script_dir ip gen_xcvr.tcl]

puts "rivet: $qsys"
puts "rivet: generating Native PHY PIPE system"
set qsys_proj [file join $build_dir qsys_shell gen_xcvr.qpf]
file mkdir [file dirname $qsys_proj]
if {[file exists $qsys_proj]} {
  set qsys_flag --quartus-project=$qsys_proj
} else {
  set qsys_flag --new-quartus-project=$qsys_proj
}
set build_abs [string map {\\ /} [file normalize $ip_dir]]
set qsys_cmd "--cmd=set ::rivet_s10gx_build $build_abs"
if {[catch {exec $qsys $qsys_flag $qsys_cmd --script=$gen_tcl 2>@1} err]} {
  error "qsys-script failed:\n$err"
}
puts $err

set qsys_file [file join $ip_dir rivet_s10gx_xcvr.qsys]
if {![file exists $qsys_file]} {
  error "missing $qsys_file"
}
puts "rivet: $qgen"
set qsys_fh [open $qsys_file r]
set qsys_txt [read $qsys_fh]
close $qsys_fh
set ip_files {}
foreach kind {pll phy rst} {
  if {![regexp "ip/rivet_s10gx_xcvr/rivet_s10gx_xcvr_${kind}_\[0-9\]+\\.ip" $qsys_txt rel]} {
    if {![regexp "ip/rivet_s10gx_xcvr/rivet_s10gx_xcvr_${kind}\\.ip" $qsys_txt rel]} {
      error "qsys does not reference a $kind ip"
    }
  }
  lappend ip_files [file join $ip_dir $rel]
}
foreach ip $ip_files {
  if {![file exists $ip]} {
    error "missing $ip"
  }
  puts "rivet: generating $ip"
  if {[catch {exec $qgen $ip --synthesis=VERILOG --part=$part --parallel=off 2>@1} err]} {
    error "qsys-generate failed for $ip:\n$err"
  }
  puts $err
}
set link_v [file join $build_dir rivet_s10gx_link.v]
rivet_emit_fixed_link $link_v
set link_fh [open $link_v r]
set link_txt [read $link_fh]
close $link_fh
foreach ip $ip_files kind {pll phy rst} {
  set mod [file rootname [file tail $ip]]
  set link_txt [string map [list rivet_s10gx_xcvr_${kind}_0 $mod] $link_txt]
}
set link_fh [open $link_v w]
puts -nonewline $link_fh $link_txt
close $link_fh
puts "rivet: wrote $link_v"

package require ::quartus::project
cd $build_dir
catch {project_close}
set proj_err ""
set proj_ok 0
for {set attempt 1} {$attempt <= 3} {incr attempt} {
  foreach stale {qdb dni} {
    catch {file delete -force [file join $build_dir $stale]}
  }
  if {$attempt > 1} {
    puts "rivet: project_new retry $attempt after: $proj_err"
    after 2000 {set ::rivet_delay_done 1}
    vwait ::rivet_delay_done
    unset ::rivet_delay_done
  }
  if {![catch {project_new -family "Stratix 10" -part $part -overwrite rivet_s10gx} proj_err]} {
    set proj_ok 1
    break
  }
}
if {!$proj_ok} {
  error "project_new failed:\n$proj_err"
}

set_global_assignment -name FAMILY "Stratix 10"
set_global_assignment -name DEVICE $part
set_global_assignment -name TOP_LEVEL_ENTITY rivet_s10gx_ep
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name PRESERVE_UNUSED_XCVR_CHANNEL ON
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_100MHZ
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
set_global_assignment -name ENABLE_ED_CRC_CHECK ON
# SmartVID on the dev kit. Without these the SOF does not configure.
set_global_assignment -name USE_PWRMGT_SCL SDM_IO14
set_global_assignment -name USE_PWRMGT_SDA SDM_IO11
set_global_assignment -name VID_OPERATION_MODE "PMBUS MASTER"
set_global_assignment -name PWRMGT_BUS_SPEED_MODE "400 KHZ"
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE LTM4677
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 4F
set_global_assignment -name PWRMGT_PAGE_COMMAND_ENABLE ON
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "AUTO DISCOVERY"
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT VOLTS
set_global_assignment -name SEARCH_PATH [file normalize [file join $build_dir src]]
set_global_assignment -name SEARCH_PATH [file normalize [file join $repo_root rtl pcie_ctrl]]

set regs_svh [file normalize [file join $script_dir .. c10gx include common_cells registers.svh]]
rivet_add_filelist $repo_root [file join $repo_root rtl filelist_core.f] $build_dir $regs_svh

set_global_assignment -name SYSTEMVERILOG_FILE [file normalize [file join $script_dir rtl rivet_s10gx_ep.sv]]
set_global_assignment -name VERILOG_FILE [file normalize [file join $build_dir rivet_s10gx_link.v]]

foreach ip $ip_files {
  set tail "[file rootname [file tail $ip]].qip"
  set qips [rivet_find_named $ip_dir $tail]
  if {[llength $qips] != 1} {
    error "expected one $tail under $ip_dir, found [llength $qips]"
  }
  set_global_assignment -name QIP_FILE [lindex $qips 0]
  puts "rivet: QIP [lindex $qips 0]"
}

set_global_assignment -name SDC_FILE [file normalize [file join $script_dir constraints s10gx_pcie.sdc]]
source [file join $script_dir constraints s10gx_pins.tcl]

project_close
puts "PASS: Quartus project [file join $build_dir rivet_s10gx.qpf]"
puts "Next: fpga\\s10gx\\impl.cmd"
